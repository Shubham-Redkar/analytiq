# AnalytIQ Backend – Environment Configuration Example
# Copy this file to .env and fill in your local values.
# Never commit the actual .env file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AnalytIQ API"
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL (must match docker-compose.yml values for local dev)
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=analytiq_db
POSTGRES_USER=analytiq
POSTGRES_PASSWORD=changeme_local_only

# Assembled automatically from the above by pydantic-settings.
# You may also set DATABASE_URL directly to override.
# DATABASE_URL=postgresql+asyncpg://analytiq:changeme_local_only@127.0.0.1:5433/analytiq_db

# ---------------------------------------------------------------------------
# CORS (JSON array of allowed origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Authentication & Sessions (Milestone M1)
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=analytiq_session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---------------------------------------------------------------------------
# LLM Provider & Secure Analytical Query Engine (Milestone M3 / M3.1)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.0
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_REQUEST_TIMEOUT_SECONDS=120.0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_PROVIDER_RETRIES=1

ANALYSIS_MAX_QUESTION_LENGTH=2000
ANALYSIS_MAX_CORRECTION_ATTEMPTS=1
ANALYSIS_MAX_CONCURRENT_REQUESTS=2
ANALYSIS_QUERY_TIMEOUT_SECONDS=15.0
ANALYSIS_MAX_RESULT_ROWS=1000
ANALYSIS_MAX_RESULT_BYTES=2097152
ANALYSIS_DUCKDB_MEMORY_LIMIT=512MB
ANALYSIS_DUCKDB_THREADS=2
